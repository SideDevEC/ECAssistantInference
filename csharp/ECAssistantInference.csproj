<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- NuGet metadata -->
    <PackageId>ECAssistantInference</PackageId>
    <Version>15.0.0</Version>
    <Authors>SideDevEC</Authors>
    <Description>C/C++ inference engine + C# bindings for ECAssistant. Links llama.cpp directly.</Description>
    <RepositoryUrl>https://github.com/SideDevEC/ECAssistantInference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <LicenseExpression>MIT</LicenseExpression>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>

  <!-- Native runtime libraries (bundled in NuGet package) -->
  <ItemGroup Condition="Exists('runtimes/osx-arm64/native/libecainference.dylib')">
    <None Include="runtimes/osx-arm64/native/libecainference.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('runtimes/linux-x64/native/libecainference.so')">
    <None Include="runtimes/linux-x64/native/libecainference.so" Pack="true" PackagePath="runtimes/linux-x64/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('runtimes/win-x64/native/ecainference.dll')">
    <None Include="runtimes/win-x64/native/ecainference.dll" Pack="true" PackagePath="runtimes/win-x64/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
